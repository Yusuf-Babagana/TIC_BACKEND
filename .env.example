# Copy to .env and fill in. NEVER commit .env (it is git-ignored). Real secrets live only there.
# Lines starting with # are optional/illustrative.

# ============================================================================
# VTU providers  -  pattern: VTU_<PROVIDER>_<SETTING>
# A provider is used only if it is ENABLED here, fully configured, switched on
# in Django admin (VTU > Provider states) and not suspended by the circuit breaker.
# Validate with:   python manage.py check      python manage.py vtu_providers [--test]
# ============================================================================

# --- Nellobytes / ClubKonnect (implemented; vtu/gateway/adapters/nellobytes.py) ---
# Defaults to ENABLED so existing deployments keep working; set to false to turn it off.
VTU_NELLOBYTES_ENABLED=true
VTU_NELLOBYTES_USER_ID=your_nellobytes_user_id
VTU_NELLOBYTES_API_KEY=your_nellobytes_api_key
# Optional:
# VTU_NELLOBYTES_BASE_URL=https://www.nellobytesystems.com
# VTU_NELLOBYTES_TIMEOUT=30
# Lower number = tried first (admin override in Django admin wins over this). Default 10.
# VTU_NELLOBYTES_PRIORITY=10
# Older names still honoured if the VTU_NELLOBYTES_* ones above are empty:
#   VTU_USER_ID, VTU_API_KEY

# --- Gongoz Concept (implemented, conservative: see docs/VTU_PROVIDERS.md "Gongoz") ---
# Token from https://www.gongozconcept.com/documentation/ . If you whitelist an IP there, use your server's.
VTU_GONGOZ_ENABLED=false
# VTU_GONGOZ_API_KEY=your_gongoz_token
# VTU_GONGOZ_BASE_URL=https://www.gongozconcept.com/api
# VTU_GONGOZ_PRIORITY=20
# Gongoz does not document its order-status words. Make ONE small real purchase, read the Status value
# of that order (GET /api/<data|topup|billpayment|cablesub>/<id>), then list the words here
# (comma separated). Until set, Gongoz orders stay PENDING and are never auto-completed/refunded.
# VTU_GONGOZ_SUCCESS_STATUSES=
# VTU_GONGOZ_FAILED_STATUSES=

# --- Adding another provider (example only - there is NO adapter for these yet) ---
# Once you have written vtu/gateway/adapters/<name>.py (see docs/VTU_PROVIDERS.md) its
# variables follow the same pattern; the exact SETTING names come from that adapter's ConfigSpec.
# VTU_EXAMPLE_ENABLED=true
# VTU_EXAMPLE_API_KEY=...
# VTU_EXAMPLE_BASE_URL=https://provider-api.example
# VTU_EXAMPLE_PRIORITY=20

# --- Routing / resilience (all optional) ---
# Consecutive health-affecting failures before a provider is suspended (default 5)
# VTU_FAILURE_THRESHOLD=5
# Minutes a suspended provider is skipped before being tried again (default 10)
# VTU_SUSPEND_MINUTES=10
# Dotted path of the routing policy class (default: priority order)
# VTU_ROUTING_POLICY=vtu.gateway.router.PriorityPolicy

# Public base URL providers use for callbacks
PUBLIC_BASE_URL=https://your-domain.example

# ============================================================================
# Rest of the platform (unchanged)
# ============================================================================
# SECRET_KEY=
# DEBUG=False
# MONNIFY_API_KEY=
# MONNIFY_SECRET_KEY=
# MONNIFY_CONTRACT_CODE=
# BREVO_API_KEY=
# CORS_ALLOWED_ORIGINS=https://app.example
# ADMIN_NOTIFICATION_EMAIL=
